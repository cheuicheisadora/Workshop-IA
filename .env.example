# ============================================================
# Workshop-IA — Variaveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# --- Banco de Dados (Neon) ---
# Obtenha em: console.neon.tech → seu projeto → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Autenticacao Google (Google Cloud Console) ---
# Obtenha em: console.cloud.google.com → APIs → Credenciais → OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# Obtenha em: resend.com → API Keys
RESEND_API_KEY=""

# --- Pagamentos (Stripe) ---
# Obtenha em: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # gere com: openssl rand -base64 32
